function Get-PhrTimestamp {
    return (Get-Date).ToString('yyyy-MM-ddTHH:mm:ss.fffzzz', $Invariant)
}

function Write-PhrLog {
    param([Parameter(Mandatory = $true)][AllowEmptyString()][string]$Line)
    Write-Host $Line
    if ($null -ne $script:LogPath) {
        [System.IO.File]::AppendAllText($script:LogPath, ((Get-PhrTimestamp) + ' ' + $Line + "`r`n"), $Utf8NoBom)
    }
}

function Stop-PhrBlocked {
    param([Parameter(Mandatory = $true)][string]$Reason)
    throw (New-Object System.InvalidOperationException('BLOCKED:' + $Reason))
}

function Get-PhrBytesSha256 {
    param([Parameter(Mandatory = $true)][AllowEmptyCollection()][byte[]]$Bytes)
    $sha = [System.Security.Cryptography.SHA256]::Create()
    try {
        $digest = $sha.ComputeHash($Bytes)
    } finally {
        $sha.Dispose()
    }
    return ([System.BitConverter]::ToString($digest) -replace '-', '')
}

function Get-PhrFileSha256 {
    param([Parameter(Mandatory = $true)][string]$LiteralPath)
    return (Get-FileHash -LiteralPath $LiteralPath -Algorithm SHA256).Hash.ToUpperInvariant()
}

function Write-PhrNewBytes {
    param(
        [Parameter(Mandatory = $true)][string]$LiteralPath,
        [Parameter(Mandatory = $true)][AllowEmptyCollection()][byte[]]$Bytes
    )
    if ([System.IO.File]::Exists($LiteralPath)) {
        Stop-PhrBlocked -Reason ('EVIDENCE_FILE_PREEXISTS:' + $LiteralPath)
    }
    $fs = New-Object System.IO.FileStream($LiteralPath, [System.IO.FileMode]::CreateNew, [System.IO.FileAccess]::Write, [System.IO.FileShare]::None)
    try {
        $fs.Write($Bytes, 0, $Bytes.Length)
        $fs.Flush($true)
    } finally {
        $fs.Dispose()
    }
    $script:EvidenceFiles.Add($LiteralPath)
}

function Write-PhrNewText {
    param(
        [Parameter(Mandatory = $true)][string]$LiteralPath,
        [Parameter(Mandatory = $true)][AllowEmptyString()][string]$Text
    )
    Write-PhrNewBytes -LiteralPath $LiteralPath -Bytes $Utf8NoBom.GetBytes($Text)
}

function ConvertTo-PhrArgumentString {
    # Single documented serialization layer: logical argv -> Windows command line
    # (CommandLineToArgvW / MSVCRT rules). Inputs are raw values, never pre-quoted.
    param([Parameter(Mandatory = $true)][AllowEmptyString()][string[]]$LaunchArgs)
    $backslash = [char]92
    $quote = [char]34
    $parts = New-Object System.Collections.Generic.List[string]
    foreach ($item in $LaunchArgs) {
        if ($item.Length -gt 0 -and $item -notmatch '[\s"]') {
            $parts.Add($item)
            continue
        }
        $sb = New-Object System.Text.StringBuilder
        [void]$sb.Append($quote)
        $pendingSlashes = 0
        foreach ($ch in $item.ToCharArray()) {
            if ($ch -eq $backslash) {
                $pendingSlashes = $pendingSlashes + 1
                continue
            }
            if ($ch -eq $quote) {
                [void]$sb.Append($backslash, [int](2 * $pendingSlashes + 1))
                [void]$sb.Append($quote)
                $pendingSlashes = 0
                continue
            }
            if ($pendingSlashes -gt 0) {
                [void]$sb.Append($backslash, [int]$pendingSlashes)
                $pendingSlashes = 0
            }
            [void]$sb.Append($ch)
        }
        if ($pendingSlashes -gt 0) {
            [void]$sb.Append($backslash, [int](2 * $pendingSlashes))
        }
        [void]$sb.Append($quote)
        $parts.Add($sb.ToString())
    }
    return ($parts.ToArray() -join ' ')
}

function Invoke-PhrChild {
    param(
        [Parameter(Mandatory = $true)][string]$ExePath,
        [Parameter(Mandatory = $true)][AllowEmptyString()][string[]]$LaunchArgs,
        [Parameter(Mandatory = $true)][int]$WatchdogSeconds,
        [Parameter(Mandatory = $true)][string]$Label
    )
    $argLine = ConvertTo-PhrArgumentString -LaunchArgs $LaunchArgs
    $psi = New-Object System.Diagnostics.ProcessStartInfo
    $psi.FileName = $ExePath
    $psi.Arguments = $argLine
    $psi.UseShellExecute = $false
    $psi.CreateNoWindow = $false
    $psi.RedirectStandardInput = $false
    $psi.RedirectStandardOutput = $false
    $psi.RedirectStandardError = $false
    $psi.WorkingDirectory = $script:RunDir
    Write-PhrLog ('CHILD_START LABEL=' + $Label + ' EXE=' + $ExePath + ' ARGS=' + $argLine)
    $proc = [System.Diagnostics.Process]::Start($psi)
    if ($null -eq $proc) {
        Stop-PhrBlocked -Reason ('CHILD_START_NULL:' + $Label)
    }
    $childPid = $proc.Id
    $script:ActiveChild = $proc
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    $nextBeat = 30
    $expired = $false
    while (-not $proc.WaitForExit(1000)) {
        $elapsed = [int][System.Math]::Floor($sw.Elapsed.TotalSeconds)
        if ($elapsed -ge $WatchdogSeconds) {
            $expired = $true
            break
        }
        if ($elapsed -ge $nextBeat) {
            Write-PhrLog ('HEARTBEAT PHASE=' + $Label + ' CHILD_PID=' + $childPid + ' ELAPSED_S=' + $elapsed + ' WATCHDOG_S=' + $WatchdogSeconds + ' SAFE_STOP=YES_READ_ONLY')
            $nextBeat = $nextBeat + 30
        }
    }
    if ($expired) {
        $script:ActiveChild = $null
        Write-PhrLog ('WATCHDOG_EXPIRED NO_KILL LABEL=' + $Label + ' CHILD_PID=' + $childPid)
        return [pscustomobject]@{ Label = $Label; Watchdog = $true; ExitCode = $null; ChildPid = $childPid; Process = $proc; ArgLine = $argLine }
    }
    $proc.WaitForExit()
    $script:ActiveChild = $null
    $rawCode = $proc.ExitCode
    if ($null -eq $rawCode) {
        Stop-PhrBlocked -Reason ('CHILD_EXITCODE_NULL:' + $Label)
    }
    $code = [int]$rawCode
    $proc.Dispose()
    Write-PhrLog ('CHILD_END LABEL=' + $Label + ' CHILD_PID=' + $childPid + ' EXIT_CODE=' + $code)
    return [pscustomobject]@{ Label = $Label; Watchdog = $false; ExitCode = $code; ChildPid = $childPid; Process = $null; ArgLine = $argLine }
}

function Read-PhrResult {
    param(
        [Parameter(Mandatory = $true)][string]$JsonPath,
        [AllowNull()][object]$ExitCode,
        [Parameter(Mandatory = $true)][bool]$Watchdog
    )
    $r = [ordered]@{ Status = 'BLOCKED'; Reason = $null; Result = $null; Sha256 = $null; Object = $null }
    if ($Watchdog) { $r.Reason = 'WATCHDOG_EXPIRED_NO_KILL'; return [pscustomobject]$r }
    if ($null -eq $ExitCode) { $r.Reason = 'EXIT_CODE_NULL'; return [pscustomobject]$r }
    if (-not [System.IO.File]::Exists($JsonPath)) { $r.Reason = 'OUT_JSON_MISSING'; return [pscustomobject]$r }
    $bytes = [System.IO.File]::ReadAllBytes($JsonPath)
    $r.Sha256 = Get-PhrBytesSha256 -Bytes $bytes
    if ($bytes.Length -ge 3 -and $bytes[0] -eq 0xEF -and $bytes[1] -eq 0xBB -and $bytes[2] -eq 0xBF) {
        $r.Reason = 'OUT_JSON_BOM_FORBIDDEN'
        return [pscustomobject]$r
    }
    try {
        $text = $Utf8Strict.GetString($bytes)
    } catch {
        $r.Reason = 'OUT_JSON_NOT_UTF8'
        return [pscustomobject]$r
    }
    try {
        $obj = ConvertFrom-Json -InputObject $text
    } catch {
        $r.Reason = 'OUT_JSON_MALFORMED'
        return [pscustomobject]$r
    }
    if ($null -eq $obj -or $obj.GetType().FullName -ne 'System.Management.Automation.PSCustomObject') {
        $r.Reason = 'OUT_JSON_NOT_OBJECT'
        return [pscustomobject]$r
    }
    $resProp = $obj.PSObject.Properties['RESULT']
    $codeProp = $obj.PSObject.Properties['EXIT_CODE']
    if ($null -eq $resProp -or -not ($resProp.Value -is [string])) { $r.Reason = 'RESULT_MISSING'; return [pscustomobject]$r }
    if ($null -eq $codeProp) { $r.Reason = 'EXIT_CODE_FIELD_MISSING'; return [pscustomobject]$r }
    $res = [string]$resProp.Value
    $r.Result = $res
    $r.Object = $obj
    if ($AllResults -notcontains $res) { $r.Reason = 'RESULT_NOT_ALLOWLISTED'; return [pscustomobject]$r }
    if ([string]$codeProp.Value -ne [string]$ExitCode) { $r.Reason = 'EXIT_CODE_FIELD_MISMATCH'; return [pscustomobject]$r }
    $expectedExit = 2
    if ($PassResults -contains $res) { $expectedExit = 0 }
    elseif ($res -eq 'FAIL_READBACK_MISMATCH') { $expectedExit = 1 }
    elseif ($res -eq 'SAFE_STOP') { $expectedExit = 130 }
    if (([int]$ExitCode) -ne $expectedExit) { $r.Reason = 'EXIT_RESULT_CONTRADICTION'; return [pscustomobject]$r }
    if ($expectedExit -eq 0) { $r.Status = 'PASS' }
    elseif ($expectedExit -eq 1) { $r.Status = 'FAIL' }
    elseif ($expectedExit -eq 130) { $r.Status = 'SAFE_STOP' }
    $r.Reason = 'CONSISTENT'
    return [pscustomobject]$r
}

function Assert-PhrPayloadIdentity {
    $physical = Get-PhrFileSha256 -LiteralPath $script:PayloadPath
