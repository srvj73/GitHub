    }
}

function Invoke-PhrStage {
    param(
        [Parameter(Mandatory = $true)][string]$Label,
        [Parameter(Mandatory = $true)][AllowEmptyString()][string[]]$StageArgs,
        [Parameter(Mandatory = $true)][int]$WatchdogSeconds,
        [Parameter(Mandatory = $true)][bool]$IsFixture
    )
    $script:Phase = 'STAGE_' + $Label
    $outPath = [System.IO.Path]::Combine($script:RunDir, ('OUT_' + $Label + '.json'))
    $launch = New-Object System.Collections.Generic.List[string]
    foreach ($x in @('-I', '-B', '-X', 'utf8', $script:PayloadPath)) { $launch.Add($x) }
    foreach ($x in $StageArgs) { $launch.Add($x) }
    $launch.Add('--out-json')
    $launch.Add($outPath)
    if ($launch[0] -ne '-I' -or $launch[1] -ne '-B' -or $launch[4] -ne $script:PayloadPath) {
        Stop-PhrBlocked -Reason ('INTERPRETER_ARGV_ORDER_INVALID:' + $Label)
    }
    Assert-PhrPayloadIdentity
    $child = Invoke-PhrChild -ExePath $PinnedPython -LaunchArgs $launch.ToArray() -WatchdogSeconds $WatchdogSeconds -Label $Label
    if ($child.Watchdog) {
        # Late writer: the child may still create its OUT json after the watchdog; reconcile registers it.
        Add-Member -InputObject $child -NotePropertyName OutPath -NotePropertyValue $outPath
        $script:Pending.Add($child)
    }
    $read = Read-PhrResult -JsonPath $outPath -ExitCode $child.ExitCode -Watchdog $child.Watchdog
    if ([System.IO.File]::Exists($outPath)) { $script:EvidenceFiles.Add($outPath) }
    $versionOk = $null
    if (-not $IsFixture -and $null -ne $read.Object) {
        $verProp = $read.Object.PSObject.Properties['python_version']
        $versionOk = ($null -ne $verProp -and ([string]$verProp.Value).StartsWith($PythonSeries, [System.StringComparison]::Ordinal))
        if (-not $versionOk -and $read.Status -eq 'PASS') {
            $read.Status = 'BLOCKED'
            $read.Reason = 'PYTHON_VERSION_NOT_PINNED_SERIES'
        }
    }
    $childReason = $null
    if ($null -ne $read.Object) {
        $reasonProp = $read.Object.PSObject.Properties['reason']
        if ($null -ne $reasonProp) { $childReason = [string]$reasonProp.Value }
    }
    $summary = [pscustomobject][ordered]@{
        label = $Label; exit_code = $child.ExitCode; watchdog = $child.Watchdog; child_pid = $child.ChildPid
        status = $read.Status; reason = $read.Reason; result = $read.Result; child_reason = $childReason
        out_json = $outPath; out_json_sha256 = $read.Sha256; python_series_ok = $versionOk
    }
    if (-not $IsFixture) { $script:Stages.Add($summary) }
    Write-PhrLog ('STAGE LABEL=' + $Label + ' STATUS=' + $read.Status + ' REASON=' + $read.Reason + ' RESULT=' + $read.Result + ' CHILD_REASON=' + $childReason + ' EXIT_CODE=' + $child.ExitCode)
    return [pscustomobject]@{ Summary = $summary; Read = $read; Child = $child }
}

function Wait-PhrPending {
    param([Parameter(Mandatory = $true)][int]$GraceSeconds)
    $out = New-Object System.Collections.Generic.List[object]
    foreach ($item in $script:Pending.ToArray()) {
        $ended = $item.Process.WaitForExit($GraceSeconds * 1000)
        $natural = $null
        $late = $null
        if ($ended) {
            $item.Process.WaitForExit()
            $natural = [int]$item.Process.ExitCode
            if ([System.IO.File]::Exists($item.OutPath)) {
                $late = $item.OutPath
                $script:EvidenceFiles.Add($item.OutPath)
            }
        }
        $out.Add([pscustomobject][ordered]@{ label = $item.Label; child_pid = $item.ChildPid; ended_naturally = $ended; natural_exit_code = $natural; killed = $false; late_out_json = $late })
        Write-PhrLog ('RECONCILE LABEL=' + $item.Label + ' CHILD_PID=' + $item.ChildPid + ' ENDED_NATURALLY=' + $ended + ' NATURAL_EXIT=' + $natural + ' KILLED=NO LATE_OUT_JSON=' + $late)
    }
    $script:Pending.Clear()
    return $out.ToArray()
}

function Test-PhrRunDirExactSet {
    # Expected set = files this run created (EvidenceFiles + log) and the retained SELFTEST_WORK dir.
    # The receipt is written afterwards and is bound by its own SHA in the summary.
    $expectedFiles = @{}
    foreach ($f in $script:EvidenceFiles.ToArray()) { $expectedFiles[$f.ToUpperInvariant()] = $true }
    $expectedFiles[$script:LogPath.ToUpperInvariant()] = $true
    $expectedDirs = @{}
    $expectedDirs[([System.IO.Path]::Combine($script:RunDir, 'SELFTEST_WORK')).ToUpperInvariant()] = $true
    $extra = New-Object System.Collections.Generic.List[string]
    $missing = New-Object System.Collections.Generic.List[string]
    $files = 0
    $dirs = 0
    try {
        foreach ($d in @([System.IO.Directory]::GetDirectories($script:RunDir, '*', [System.IO.SearchOption]::AllDirectories))) {
            $dirs = $dirs + 1
            if (-not $expectedDirs.ContainsKey($d.ToUpperInvariant())) { $extra.Add($d + '') }
        }
        $seen = @{}
        foreach ($f in @([System.IO.Directory]::GetFiles($script:RunDir, '*', [System.IO.SearchOption]::AllDirectories))) {
            $files = $files + 1
            $seen[$f.ToUpperInvariant()] = $true
            if (-not $expectedFiles.ContainsKey($f.ToUpperInvariant())) { $extra.Add($f) }
        }
        foreach ($k in $expectedFiles.Keys) { if (-not $seen.ContainsKey($k)) { $missing.Add($k) } }
        $status = 'PASS'
        if ($extra.Count -gt 0 -or $missing.Count -gt 0) { $status = 'FAIL_CARDINALITY' }
    } catch {
        $status = 'INSPECTION_FAILED:' + $_.Exception.GetType().FullName
    }
    return [pscustomobject][ordered]@{ status = $status; file_count = $files; dir_count = $dirs; extra = $extra.ToArray(); missing = $missing.ToArray() }
}

function Write-PhrDiskSnapshot {
    param([Parameter(Mandatory = $true)][string]$Label)
    $script:Phase = 'SNAPSHOT_' + $Label
    $disks = @(Get-Disk | Select-Object -Property Number, FriendlyName, SerialNumber, Size, OperationalStatus, IsOffline, IsReadOnly, PartitionStyle, BusType)
    $parts = @(Get-Partition | Select-Object -Property DiskNumber, PartitionNumber, DriveLetter, Size, Type)
    $vols = @(Get-Volume | Select-Object -Property DriveLetter, FileSystemLabel, FileSystem, Size, SizeRemaining)
    $payload = [ordered]@{ captured_at = (Get-PhrTimestamp); disks = $disks; partitions = $parts; volumes = $vols }
    $json = ConvertTo-Json -InputObject $payload -Depth 6 -Compress
    $path = [System.IO.Path]::Combine($script:RunDir, ('SNAPSHOT_' + $Label + '.json'))
    Write-PhrNewText -LiteralPath $path -Text $json
    Write-PhrLog ('SNAPSHOT LABEL=' + $Label + ' DISKS=' + $disks.Count + ' PARTITIONS=' + $parts.Count + ' VOLUMES=' + $vols.Count)
    return $path
}

