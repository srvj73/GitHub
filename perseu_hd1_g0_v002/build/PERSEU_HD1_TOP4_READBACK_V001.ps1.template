function Test-PhrFixtureMatrix {
    $matrix = @(
        @('pass', 'PASS', 'CONSISTENT', 120),
        @('fail', 'FAIL', 'CONSISTENT', 120),
        @('safe-stop', 'SAFE_STOP', 'CONSISTENT', 120),
        @('blocked', 'BLOCKED', 'CONSISTENT', 120),
        @('contradict', 'BLOCKED', 'EXIT_RESULT_CONTRADICTION', 120),
        @('malformed', 'BLOCKED', 'OUT_JSON_MALFORMED', 120),
        @('nofile', 'BLOCKED', 'OUT_JSON_MISSING', 120),
        @('bom', 'BLOCKED', 'OUT_JSON_BOM_FORBIDDEN', 120),
        @('sleep', 'BLOCKED', 'WATCHDOG_EXPIRED_NO_KILL', 3)
    )
    $allOk = $true
    foreach ($row in $matrix) {
        $run = Invoke-PhrStage -Label ('FIXTURE_' + $row[0].ToUpperInvariant()) -StageArgs @('--fixture-child', $row[0]) -WatchdogSeconds ([int]$row[3]) -IsFixture $true
        $ok = ($run.Read.Status -eq $row[1]) -and ($run.Read.Reason -eq $row[2])
        if (-not $ok) { $allOk = $false }
        $script:Fixtures.Add([pscustomobject][ordered]@{ scenario = $row[0]; expected_status = $row[1]; expected_reason = $row[2]; status = $run.Read.Status; reason = $run.Read.Reason; exit_code = $run.Child.ExitCode; pass = $ok })
    }
    $reconciled = @(Wait-PhrPending -GraceSeconds 60)
    foreach ($rec in $reconciled) {
        if (-not $rec.ended_naturally -or $rec.natural_exit_code -ne 0) { $allOk = $false }
    }
    return [pscustomobject][ordered]@{ pass = $allOk; reconciled = $reconciled }
}

