$exitCode = 2
$finalResult = 'BLOCKED'
$finalReason = $null
$startedAt = Get-PhrTimestamp
$wrapperPath = $null
$wrapperSha = $null
$pythonSha = $null
$runId = $null
$int64Vector = $null
$argvProbe = $null
$fixtureMatrix = $null
$bindingStability = $null
$cleanupInfo = [ordered]@{
    status = 'NOT_APPLICABLE'; path = $null; entries_before = $null
    bytes_freed = [int64]0; attempted = $false; retained_reason = $null; inspection_error = $null
}
$exactSet = $null
$script:TryCompleted = $false
$script:Caught = $false
$script:Interrupted = $false
$readbackStatus = 'NOT_RUN'
$readbackReport = $null
$childAfterInterrupt = $null
$receiptPath = $null
$receiptSha = $null
$clrText = 'NOT_REPORTED'
$edition = 'UNKNOWN'
$psVer = $null

try {
    Write-Host $ResultContext
    $script:Phase = 'ENVIRONMENT_GATES'
    if ($env:OS -ne 'Windows_NT') { Stop-PhrBlocked -Reason 'WINDOWS_TARGET_REQUIRED' }
    $edition = 'Desktop'
    $editionProp = $PSVersionTable.PSObject.Properties['PSEdition']
    if ($null -ne $editionProp) { $edition = [string]$editionProp.Value }
    $psVer = $PSVersionTable.PSVersion
    $clrProp = $PSVersionTable.PSObject.Properties['CLRVersion']
    if ($null -ne $clrProp -and $null -ne $clrProp.Value) { $clrText = [string]$clrProp.Value }
    if ($edition -ne 'Desktop' -or $psVer.Major -ne 5 -or $psVer.Minor -ne 1) {
        Stop-PhrBlocked -Reason ('WINDOWS_POWERSHELL_51_DESKTOP_REQUIRED:' + $edition + ':' + $psVer.ToString())
    }
    if ([string]::IsNullOrEmpty($PSCommandPath)) { Stop-PhrBlocked -Reason 'LAUNCH_WITH_DASH_FILE_REQUIRED' }
    $wrapperPath = $PSCommandPath
    $wrapperSha = Get-PhrFileSha256 -LiteralPath $wrapperPath
    if (-not [System.IO.Directory]::Exists($DownloadsRoot)) { Stop-PhrBlocked -Reason ('CANONICAL_DOWNLOADS_MISSING:' + $DownloadsRoot) }

    $script:Phase = 'RUN_DIR'
    $runId = (Get-Date).ToString('yyyyMMdd_HHmmss_fff', $Invariant) + '_' + $PID
    if (-not [System.IO.Directory]::Exists($EvidenceRoot)) { [void][System.IO.Directory]::CreateDirectory($EvidenceRoot) }
    $runDirCandidate = [System.IO.Path]::Combine($EvidenceRoot, ($Mode.ToUpperInvariant() + '_' + $runId))
    if ([System.IO.Directory]::Exists($runDirCandidate) -or [System.IO.File]::Exists($runDirCandidate)) { Stop-PhrBlocked -Reason 'RUN_DIR_PREEXISTS' }
    [void][System.IO.Directory]::CreateDirectory($runDirCandidate)
    $script:RunDir = $runDirCandidate
    $script:LogPath = [System.IO.Path]::Combine($script:RunDir, 'RUN_LOG.txt')
    Write-PhrLog ('REVISION=' + $Revision + ' MODE=' + $Mode + ' RUN_ID=' + $runId)
    Write-PhrLog ('WRAPPER=' + $wrapperPath + ' WRAPPER_SHA256=' + $wrapperSha)
    Write-PhrLog ('RUN_DIR=' + $script:RunDir + ' LOG=' + $script:LogPath)
    Write-PhrLog ('POWERSHELL=' + $edition + ' ' + $psVer.ToString() + ' CLR=' + $clrText + ' OS=' + [System.Environment]::OSVersion.VersionString)
    Write-PhrLog 'PROTECTED_EFFECTS=NONE SOURCE_DELETE=NO TARGET_DISK_MUTATION=NO C2_FULL_STARTED=NO'

    $script:Phase = 'PYTHON_GATE'
    if (-not (Test-Path -LiteralPath $PinnedPython -PathType Leaf)) { Stop-PhrBlocked -Reason ('PINNED_PYTHON_NOT_FOUND:' + $PinnedPython) }
    $pythonSha = Get-PhrFileSha256 -LiteralPath $PinnedPython
    Write-PhrLog ('PYTHON=' + $PinnedPython + ' PYTHON_EXE_SHA256=' + $pythonSha)

    $script:Phase = 'PAYLOAD_MATERIALIZE'
    $payloadBytes = [System.Convert]::FromBase64String(($PayloadB64 -replace '\s', ''))
    if ([int64]$payloadBytes.Length -ne $PayloadByteCount) { Stop-PhrBlocked -Reason ('PAYLOAD_LENGTH_MISMATCH:' + $payloadBytes.Length) }
    $embeddedSha = Get-PhrBytesSha256 -Bytes $payloadBytes
    if ($embeddedSha -ne $PayloadSha256) { Stop-PhrBlocked -Reason ('PAYLOAD_EMBEDDED_SHA_MISMATCH:' + $embeddedSha) }
    $script:PayloadPath = [System.IO.Path]::Combine($script:RunDir, $PayloadName)
    Write-PhrNewBytes -LiteralPath $script:PayloadPath -Bytes $payloadBytes
    Assert-PhrPayloadIdentity
    Write-PhrLog ('PAYLOAD=' + $script:PayloadPath + ' PAYLOAD_SHA256=' + $PayloadSha256 + ' BYTES=' + $PayloadByteCount)

    $ok = $true
    if ($Mode -eq 'SelfTest') {
        $script:Phase = 'INT64_VECTOR'
        $int64Vector = Test-PhrInt64Vector
        Write-PhrLog ('INT64_VECTOR PASS=' + $int64Vector.pass + ' SUM=' + $int64Vector.sum)
        if (-not $int64Vector.pass) { $ok = $false }
        $script:Phase = 'ARGV_PROBE'
        $argvProbe = Test-PhrArgvProbe
        Write-PhrLog ('ARGV_PROBE PASS=' + $argvProbe.pass + ' RECEIVED=' + $argvProbe.received_count + '/' + $argvProbe.expected_count)
        if (-not $argvProbe.pass) { $ok = $false }
        $script:Phase = 'FIXTURE_MATRIX'
        $fixtureMatrix = Test-PhrFixtureMatrix
        Write-PhrLog ('FIXTURE_MATRIX PASS=' + $fixtureMatrix.pass)
        if (-not $fixtureMatrix.pass) { $ok = $false }
        $workDir = [System.IO.Path]::Combine($script:RunDir, 'SELFTEST_WORK')
        [void][System.IO.Directory]::CreateDirectory($workDir)
        $st = Invoke-PhrStage -Label 'PAYLOAD_SELFTEST' -StageArgs @('--selftest', '--work-dir', $workDir) -WatchdogSeconds 600 -IsFixture $false
        if ($st.Read.Status -ne 'PASS') { $ok = $false }
        # Lifecycle V003: the EMPTY run-owned workspace is retained as evidence; no delete is ever
        # attempted (V002 Directory.Delete was denied on the target, cause not proven). Inspection
        # failure is a recorded substatus and fail-closed, but never aborts the mandatory stages below.
        $cleanupInfo.path = $workDir
        $leftovers = $null
        try {
            $leftovers = @([System.IO.Directory]::GetFileSystemEntries($workDir))
        } catch {
            $cleanupInfo.inspection_error = $_.Exception.GetType().FullName + ':' + [string]$_.Exception.Message
        }
        if ($null -eq $leftovers) {
            $cleanupInfo.status = 'INSPECTION_FAILED_PRESERVED'
            $cleanupInfo.retained_reason = 'WORKSPACE_STATE_UNVERIFIED'
            $ok = $false
        } elseif ($leftovers.Count -eq 0) {
            $cleanupInfo.entries_before = 0
            $cleanupInfo.status = 'RETAINED_EMPTY_BY_DESIGN'
            $cleanupInfo.retained_reason = 'RUN_OWNED_SELFTEST_EVIDENCE_NO_DELETE_ON_WINDOWS_TARGET'
        } else {
            $cleanupInfo.entries_before = [int]$leftovers.Count
            $cleanupInfo.status = 'FAILED_PRESERVED_NONEMPTY'
            $cleanupInfo.retained_reason = 'SELFTEST_UNEXPECTED_TRANSIENT_ENTRIES_REVIEW_REQUIRED'
            $ok = $false
        }
        Write-PhrLog ('CLEANUP_STATUS=' + $cleanupInfo.status + ' PATH=' + $workDir + ' ENTRIES=' + $cleanupInfo.entries_before + ' DELETE_ATTEMPTED=NO BYTES_FREED=0 INSPECTION_ERROR=' + $cleanupInfo.inspection_error)
    }
    if ($Mode -eq 'Readback') {
        $script:Phase = 'OWNER_DECISIONS'
        if ($D1Connection -eq 'NOT_DECLARED' -or $D2WriteProtection -eq 'NOT_DECLARED') { Stop-PhrBlocked -Reason 'OWNER_DECISIONS_D1_D2_REQUIRED_NO_EFFECT' }
        Write-PhrLog ('OWNER_DECISION D1_CONNECTION=' + $D1Connection + ' D2_WRITE_PROTECTION=' + $D2WriteProtection + ' SCRIPT_DISK_MUTATION=NO')
        if (-not [System.IO.Directory]::Exists($StateParent)) { Stop-PhrBlocked -Reason ('STATE_PARENT_MISSING:' + $StateParent) }
        if (-not [System.IO.Directory]::Exists($StateRoot)) { [void][System.IO.Directory]::CreateDirectory($StateRoot) }
        $snapPre = Write-PhrDiskSnapshot -Label 'PRE'
        $readbackReport = [System.IO.Path]::Combine($script:RunDir, 'READBACK_REPORT.json')
        $rbArgs = New-Object System.Collections.Generic.List[string]
        foreach ($x in @('--readback', '--snapshot', $snapPre, '--state-root', $StateRoot, '--report-json', $readbackReport)) { $rbArgs.Add($x) }
        if ($D2WriteProtection -eq 'DISK_READONLY_ATTRIBUTE_SET_BY_OWNER') { $rbArgs.Add('--require-readonly') }
        $rb = Invoke-PhrStage -Label 'READBACK' -StageArgs $rbArgs.ToArray() -WatchdogSeconds 43200 -IsFixture $false
        if ([System.IO.File]::Exists($readbackReport)) { $script:EvidenceFiles.Add($readbackReport) } else { $readbackReport = $null }
        $readbackStatus = $rb.Read.Status
        if ($rb.Read.Status -ne 'PASS') { $ok = $false }
        if (-not $rb.Child.Watchdog) { [void](Write-PhrDiskSnapshot -Label 'POST') }
    }
    if ($script:Pending.Count -gt 0) {
        [void](Wait-PhrPending -GraceSeconds 60)
        $ok = $false
    }
    $script:Phase = 'RUN_DIR_EXACT_SET'
    $exactSet = Test-PhrRunDirExactSet
    Write-PhrLog ('RUN_DIR_EXACT_SET=' + $exactSet.status + ' FILES=' + $exactSet.file_count + ' DIRS=' + $exactSet.dir_count + ' EXTRA=' + $exactSet.extra.Count + ' MISSING=' + $exactSet.missing.Count)
    if ($exactSet.status -ne 'PASS') { $ok = $false }
    $otherOk = $ok -or ($Mode -eq 'Readback' -and ($readbackStatus -eq 'FAIL' -or $readbackStatus -eq 'SAFE_STOP') -and $exactSet.status -eq 'PASS' -and $script:Pending.Count -eq 0)
    if ($Mode -eq 'Readback' -and $readbackStatus -eq 'FAIL' -and $otherOk) {
        $finalResult = 'FAIL'
        $finalReason = 'READBACK_SHA_MISMATCH_SEE_REPORT'
        $exitCode = 1
    } elseif ($Mode -eq 'Readback' -and $readbackStatus -eq 'SAFE_STOP' -and $otherOk) {
        $finalResult = 'SAFE_STOP'
        $finalReason = 'SAFE_STOP_RESUMABLE_RERUN_SAME_COMMAND'
        $exitCode = 130
    } elseif ($ok) {
        $finalResult = 'PASS'
        $finalReason = 'ALL_STAGES_PASS'
        $exitCode = 0
    } else {
        $finalReason = 'STAGE_NOT_PASS_SEE_RECEIPT'
    }
    $script:TryCompleted = $true
} catch {
    $script:Caught = $true
    $msg = [string]$_.Exception.Message
    $finalResult = 'BLOCKED'
    if ($msg.StartsWith('BLOCKED:', [System.StringComparison]::Ordinal)) {
        $finalReason = $msg.Substring(8)
    } else {
        $finalReason = 'UNEXPECTED_' + $_.Exception.GetType().FullName + ':' + $msg
    }
    $exitCode = 2
    try { Write-PhrLog ('ERROR PHASE=' + $script:Phase + ' REASON=' + $finalReason) } catch { Write-Host ('ERROR PHASE=' + $script:Phase + ' REASON=' + $finalReason) }
} finally {
    if (-not $script:TryCompleted -and -not $script:Caught) {
        # Neither completed nor failed: the pipeline was stopped (Ctrl+C). Reconcile the child, never kill it.
        $script:Interrupted = $true
        $finalResult = 'SAFE_STOP'
        $finalReason = 'WRAPPER_INTERRUPTED_CTRL_C_CHILD_RECONCILED'
        $exitCode = 130
        try {
            if ($null -ne $script:ActiveChild) {
                $exitedInTime = $script:ActiveChild.WaitForExit(120000)
                $childAfterInterrupt = [ordered]@{ child_pid = $script:ActiveChild.Id; exited = $exitedInTime; exit_code = $null; killed = $false; source = 'ACTIVE_CHILD' }
                if ($exitedInTime) { $script:ActiveChild.WaitForExit(); $childAfterInterrupt.exit_code = [int]$script:ActiveChild.ExitCode }
            } else {
                $childAfterInterrupt = [ordered]@{ child_pid = $null; exited = $true; exit_code = $null; killed = $false; source = 'CHILD_ALREADY_EXITED_BEFORE_STOP' }
            }
        } catch {
            $childAfterInterrupt = [ordered]@{ error = $_.Exception.GetType().FullName; killed = $false }
        }
    }
    if ($null -ne $script:RunDir) {
        try {
            $script:Phase = 'RECEIPT'
            $evidence = New-Object System.Collections.Generic.List[object]
            foreach ($f in $script:EvidenceFiles.ToArray()) {
                $evidence.Add([pscustomobject][ordered]@{ path = $f; bytes = [int64](New-Object System.IO.FileInfo($f)).Length; sha256 = (Get-PhrFileSha256 -LiteralPath $f) })
            }
            $g0Target = 'NOT_PROVEN'
            if ($Mode -eq 'SelfTest' -and $finalResult -eq 'PASS') { $g0Target = 'PASS_WINDOWS_SELFTEST_SCOPE' }
            if ($Mode -eq 'Readback' -and ($finalResult -eq 'PASS' -or $finalResult -eq 'FAIL')) { $g0Target = 'PASS_WINDOWS_READBACK_EXECUTED' }
            $receipt = [ordered]@{
                schema = 'PERSEU_HD1_TOP4_READBACK_V001_WRAPPER_RECEIPT'
                PROJECT = $ProjectName; THREAD = $ThreadName; SUBFRONT = $SubfrontName; REVISION = $Revision
                POLICY_MASTER_SHA256_AT_BUILD = $PolicyMasterSha256
                MODE = $Mode; RUN_ID = $runId; started_at = $startedAt; finished_at = (Get-PhrTimestamp)
                RESULT = $finalResult; REASON = $finalReason; EXIT_CODE = $exitCode; LAST_PHASE = $script:Phase
                powershell = ($edition + ' ' + [string]$psVer); clr = $clrText
                os = [System.Environment]::OSVersion.VersionString
                wrapper_path = $wrapperPath; wrapper_sha256 = $wrapperSha
                python_path = $PinnedPython; python_exe_sha256 = $pythonSha
                payload_path = $script:PayloadPath; payload_sha256 = $PayloadSha256; payload_bytes = $PayloadByteCount
                stages = $script:Stages.ToArray(); fixture_matrix = $script:Fixtures.ToArray()
                fixture_reconcile = $(if ($null -ne $fixtureMatrix) { $fixtureMatrix.reconciled } else { $null })
                int64_vector = $int64Vector; argv_probe = $argvProbe; binding_stability = $bindingStability
                OWNER_DECISION_D1 = $D1Connection; OWNER_DECISION_D2 = $D2WriteProtection; STATE_ROOT = $StateRoot
                READBACK_STATUS = $readbackStatus; READBACK_REPORT = $readbackReport; child_after_interrupt = $childAfterInterrupt; INTERRUPTED = $script:Interrupted
                MAIN_RESULT = $finalResult; CLEANUP_STATUS = $cleanupInfo.status; cleanup = $cleanupInfo; run_dir_exact_set = $exactSet
                evidence_files = $evidence.ToArray(); log_path = $script:LogPath; log_sha256 = 'NOT_BOUND_LOG_APPENDED_AFTER_RECEIPT'
                G0_TARGET_RUNTIME = $g0Target
                PROTECTED_EFFECTS = 'NONE'; EVIDENCE_WRITES_ROOT = $script:RunDir
                SOURCE_DELETE = 'NO'; TARGET_DISK_MUTATION = 'NO'; C2_FULL_STARTED = 'NO'
                RESULT_RETURN_TO = $ResultFooter
            }
            $receiptPath = [System.IO.Path]::Combine($script:RunDir, 'RECEIPT_' + $Mode.ToUpperInvariant() + '.json')
            Write-PhrNewText -LiteralPath $receiptPath -Text (ConvertTo-Json -InputObject $receipt -Depth 8)
            $receiptSha = Get-PhrFileSha256 -LiteralPath $receiptPath
        } catch {
            $exitCode = 2
            $finalResult = 'BLOCKED'
            $finalReason = 'RECEIPT_WRITE_FAILED:' + [string]$_.Exception.Message + ' PRIMARY=' + $finalReason
            try { Write-PhrLog ('RECEIPT_WRITE_FAILED ' + [string]$_.Exception.Message) } catch { Write-Host ('RECEIPT_WRITE_FAILED ' + [string]$_.Exception.Message) }
        }
    }
    try {
        Write-PhrLog '=== SUMMARY ==='
        Write-PhrLog ('RESULT=' + $finalResult)
        Write-PhrLog ('REASON=' + $finalReason)
        Write-PhrLog ('EXIT_CODE=' + $exitCode)
        Write-PhrLog ('MODE=' + $Mode)
        Write-PhrLog ('CLEANUP_STATUS=' + $cleanupInfo.status + ' CLEANUP_ATTEMPTED=' + $cleanupInfo.attempted + ' CLEANUP_RETAINED_REASON=' + $cleanupInfo.retained_reason)
        if ($null -ne $exactSet) { Write-PhrLog ('RUN_DIR_EXACT_SET=' + $exactSet.status) }
        Write-PhrLog ('RUN_DIR=' + $script:RunDir)
        Write-PhrLog ('RECEIPT=' + $receiptPath)
        Write-PhrLog ('RECEIPT_SHA256=' + $receiptSha)
        Write-PhrLog ('WRAPPER_SHA256=' + $wrapperSha)
        Write-PhrLog ('PAYLOAD_SHA256=' + $PayloadSha256)
        foreach ($s in $script:Stages.ToArray()) {
            Write-PhrLog ('STAGE_RESULT ' + $s.label + '=' + $s.status + ' REASON=' + $s.reason + ' CHILD_REASON=' + $s.child_reason)
        }
        Write-PhrLog 'PROTECTED_EFFECTS=NONE'
        Write-PhrLog $ResultFooter
    } catch {
        Write-Host $ResultFooter
    }
    if ($script:Interrupted -and ([System.Environment]::CommandLine -match '(?i)\s-File\s')) {
        [System.Environment]::Exit($exitCode)
    }
}
exit $exitCode
