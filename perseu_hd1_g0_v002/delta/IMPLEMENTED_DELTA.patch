+def parse_snapshot(snapshot: object) -> tuple[list, list, list]:
+    if not isinstance(snapshot, dict):
+        raise Blocked('SNAPSHOT_NOT_OBJECT')
+    disks, parts, vols = seq(snapshot.get('disks')), seq(snapshot.get('partitions')), seq(snapshot.get('volumes'))
+    for item in disks + parts + vols:
+        if not isinstance(item, dict):
+            raise Blocked('SNAPSHOT_ITEM_NOT_OBJECT')
+    for d in disks:
+        if strict_int(d.get('Number')) is None:
+            raise Blocked('DISK_NUMBER_NOT_INT')
+        if strict_int(d.get('Size')) is None or d['Size'] < 0:
+            raise Blocked('DISK_SIZE_NOT_INT64')
+        for key in ('SerialNumber', 'FriendlyName'):
+            if d.get(key) is not None and not isinstance(d.get(key), str):
+                raise Blocked('DISK_' + key.upper() + '_NOT_STRING')
+    numbers = [d['Number'] for d in disks]
+    if len(numbers) != len(set(numbers)):
+        raise Blocked('DISK_NUMBER_DUPLICATED')
+    for p in parts:
+        if strict_int(p.get('DiskNumber')) is None:
+            raise Blocked('PARTITION_DISKNUMBER_NOT_INT')
+    return disks, parts, vols
+
+
+def letters_for_disk(parts: list, number: int) -> list[str]:
+    out = []
+    for p in parts:
+        if p['DiskNumber'] == number:
+            letter = letter_of(p.get('DriveLetter'))
+            if letter is not None:
+                out.append(letter)
+    return out
+
+
+def letter_owner_count(parts: list, letter: str) -> int:
+    return sum(1 for p in parts if letter_of(p.get('DriveLetter')) == letter)
+
