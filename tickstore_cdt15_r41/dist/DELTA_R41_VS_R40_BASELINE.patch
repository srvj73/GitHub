+def canonical(obj) -> bytes:
+    # Byte-compatible with the MENU consumer and the sandbox model.
+    return (json.dumps(obj, sort_keys=True, ensure_ascii=False, separators=(',', ':')) + '\n').encode('utf-8')
+
