+    layout.validate()
+    with ExclusiveLock(layout.lock):
+        plan, phase, evidence, plan_sha = load_transaction(layout.tx)
+        require(phase == 'ROLLED_BACK', 'ARCHIVE_ONLY_ROLLED_BACK')
