+    """CREATE_NEW + flush (FlushFileBuffers via fsync) + independent readback."""
+    fd = core.secure_create_new_fd(Path(path))
+    with os.fdopen(fd, 'wb') as stream:
+        stream.write(raw)
+        stream.flush()
+        os.fsync(stream.fileno())
